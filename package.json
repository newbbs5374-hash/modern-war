{
  "name": "modern-war",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "vitest run --config sim/vitest.config.ts --silent=false",
    "hexmap": "OUT=docs/hexmap.svg vitest run --config sim/vitest.config.ts sim/hex.test.ts",
    "worldart": "vitest run --config sim/vitest.config.ts sim/worldart.test.ts",
    "faces": "vitest run --config sim/vitest.config.ts sim/faces.test.ts",
    "seagrid": "vitest run --config sim/vitest.config.ts sim/seagrid.test.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0",
    "three128": "npm:three@^0.128.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
